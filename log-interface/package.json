{
  "name": "@owneraio/log-interface",
  "version": "0.29.0",
  "description": "Branded, backend-agnostic logging interface for FinP2P adapters, with winston and console factories",
  "homepage": "https://ownera.io/",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./winston": {
      "types": "./dist/winston.d.ts",
      "default": "./dist/winston.js"
    }
  },
  "typesVersions": {
    "*": {
      "winston": [
        "dist/winston.d.ts"
      ]
    }
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "prebuild": "eslint ./src ./tests --ext .ts --fix",
    "build": "tsc -p tsconfig.build.json",
    "test": "jest"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "peerDependencies": {
    "winston": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "winston": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/jest": "^29.2.0",
    "@types/node": "^16.11.12",
    "@typescript-eslint/eslint-plugin": "^5.6.0",
    "@typescript-eslint/parser": "^5.6.0",
    "eslint": "^8.4.1",
    "eslint-config-airbnb-typescript": "^16.1.0",
    "eslint-plugin-import": "^2.25.4",
    "jest": "^29.7.0",
    "ts-jest": "^29.0.3",
    "typescript": "^5.2.0",
    "winston": "^3.18.3",
    "winston-transport": "^4.9.0"
  }
}
